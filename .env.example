# --- Local (stdio) mode -------------------------------------------------------
# Required: your Nextcloud. Nothing else is needed: the first tool call returns a
# login link (Login Flow v2) and the app password is saved to
# ~/.config/nextcloud-mcp/credentials.json. Or run `nextcloud-mcp login <url>` once.
NEXTCLOUD_URL=https://cloud.example.com

# Optional instead of the login link: an app password you created yourself
# (Nextcloud: Settings -> Security -> Devices & sessions -> Create new app password).
# NEXTCLOUD_USER=jane
# NEXTCLOUD_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Optional: enable upload/create/move/copy/delete tools. Default is read-only.
# NEXTCLOUD_ENABLE_WRITES=true

# Optional: time zone for dates in markdown output (default: the system time zone)
# NEXTCLOUD_TIMEZONE=Europe/Amsterdam

# Optional limits
# NEXTCLOUD_MAX_READ_MB=10
# NEXTCLOUD_MAX_UPLOAD_MB=100
# NEXTCLOUD_CHARACTER_LIMIT=25000
# NEXTCLOUD_TIMEOUT_MS=30000

# --- Hosted mode (node dist/index.js --http) ------------------------------------
# NEXTCLOUD_MCP_PUBLIC_URL=https://nextcloud-mcp.example.com
# NEXTCLOUD_MCP_SECRET=            # openssl rand -base64 48 — encrypts stored credentials
# NEXTCLOUD_MCP_DB_PATH=/data/nextcloud-mcp.sqlite
# NEXTCLOUD_ALLOWED_GROUPS=claude  # only these Nextcloud groups may connect (comma-separated)
# NEXTCLOUD_ALLOWED_USERS=         # and/or these user IDs
# Optional: Nextcloud OAuth2 instead of Login Flow v2. Register the client in Nextcloud
# (Administration -> Security -> OAuth 2.0 clients) with redirect URI
# <NEXTCLOUD_MCP_PUBLIC_URL>/connect/callback.
# NEXTCLOUD_OAUTH_CLIENT_ID=
# NEXTCLOUD_OAUTH_CLIENT_SECRET=
# Redirect URIs MCP clients may register, in addition to the built-in claude.ai / claude.com
# callbacks and loopback (http://localhost:*, http://127.0.0.1:*, http://[::1]:*).
# NEXTCLOUD_MCP_ALLOWED_REDIRECT_URIS=https://app.example.com/oauth/callback
# NEXTCLOUD_MCP_DEFAULT_REDIRECT_URIS=false   # drop the built-ins, allow only the list above
# NEXTCLOUD_MCP_ICON_PATH=/config/icon.svg
